# ==========================================
# TOPFEROS MD
# Environment Configuration
# ==========================================

# Bot Information
BOT_NAME=TOPFEROS MD
BOT_VERSION=1.0.0
PREFIX=.
MODE=public

# Owner Information
OWNER_NAME=TOPFEROS TECH
OWNER_NUMBER=50900000000

# Server
PORT=3000

# Timezone
TIMEZONE=America/Port-au-Prince

# Session
SESSION_ID=

# Database
DATABASE=mongodb
MONGODB_URI=

# APIs
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
REMOVE_BG_API_KEY=
IMGBB_API_KEY=
OPENWEATHER_API_KEY=
YOUTUBE_API_KEY=

# Security
JWT_SECRET=topferos_md_secret
SESSION_SECRET=topferos_md_session

# Logs
LOG_LEVEL=info

# Features
AUTO_READ=true
AUTO_TYPING=false
AUTO_RECORDING=false
AUTO_REACT=false
WELCOME=true
GOODBYE=true
ANTI_LINK=true
ANTI_DELETE=true
AUTO_STATUS_VIEW=false

# Pairing
USE_PAIRING_CODE=true
PAIRING_NUMBER=

# Dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123